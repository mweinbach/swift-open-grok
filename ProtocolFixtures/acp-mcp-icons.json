{
  "$schema": "open-grok/protocol-fixtures/acp-mcp-icons",
  "referenceRevision": "b962dfa6dd9a49df96d28412eae3a8f5478b0dfa",
  "method": "x.ai/mcp/list",
  "serverIconsKey": "icons",
  "toolIconsPath": "session.tools[].icons",
  "iconWireKeys": [
    "src",
    "mimeType",
    "sizes",
    "theme"
  ],
  "acceptedSourcePrefixes": [
    "https://",
    "data:image/"
  ],
  "rejectedSourceExamples": [
    "",
    "   ",
    "http://example.com/icon.png",
    "javascript:alert(1)",
    "file:///private/session.json",
    "HTTPS://example.com/icon.png",
    "data:text/html,secret"
  ],
  "limits": {
    "maximumIconsPerEntity": 8,
    "maximumSourceBytes": 65536,
    "maximumMimeTypeBytes": 128,
    "maximumSizes": 8,
    "maximumSizeTokenBytes": 32
  },
  "themes": [
    "light",
    "dark"
  ],
  "omission": {
    "emptyServerIconsOmitted": true,
    "emptyToolIconsOmitted": true,
    "absentOptionalMetadataOmitted": true,
    "unknownThemesOmitted": true,
    "invalidOptionalMetadataDropped": true
  },
  "examples": {
    "serverWithToolIcons": {
      "name": "custom",
      "icons": [
        {
          "src": "https://example.com/icon.png",
          "mimeType": "image/png",
          "sizes": [
            "48x48"
          ],
          "theme": "dark"
        }
      ],
      "source": "local",
      "type": "http",
      "url": "https://example.com/mcp",
      "session": {
        "enabled": true,
        "status": "ready",
        "tools": [
          {
            "name": "search",
            "icons": [
              {
                "src": "https://example.com/icon.png",
                "mimeType": "image/png",
                "sizes": [
                  "48x48"
                ],
                "theme": "dark"
              }
            ],
            "enabled": true
          }
        ]
      }
    },
    "serverWithoutIcons": {
      "name": "legacy",
      "source": "local",
      "type": "http",
      "url": "https://example.com/mcp",
      "session": {
        "enabled": true,
        "status": "ready",
        "tools": [
          {
            "name": "search",
            "enabled": true
          }
        ]
      }
    },
    "minimalIcon": {
      "src": "data:image/png;base64,AAAA"
    }
  },
  "provenance": {
